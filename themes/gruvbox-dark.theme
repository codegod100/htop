# Gruvbox dark-inspired htop theme (8-color terminal palette).
# Best with a Gruvbox Dark terminal color scheme.
# Warm yellow/orange + purple + blue — not stock cyan/green/red.
name=Gruvbox Dark
force_black_bg=0

DEFAULT_COLOR = white default
RESET_COLOR = white default
FUNCTION_BAR = black yellow
FUNCTION_KEY = white default bold
PANEL_HEADER_FOCUS = black yellow
PANEL_HEADER_UNFOCUS = black yellow
PANEL_SELECTION_FOCUS = black yellow
PANEL_SELECTION_FOLLOW = black magenta
PANEL_SELECTION_UNFOCUS = black white
