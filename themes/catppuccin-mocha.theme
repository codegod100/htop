CPU_GUEST = magenta default bold
GPU_ENGINE_1 = blue default bold
GPU_ENGINE_2 = yellow default
GPU_ENGINE_3 = magenta default
GPU_ENGINE_4 = yellow default bold
GPU_RESIDUE = white default
PANEL_EDIT = black blue
SCREENS_OTH_BORDER = blue blue
SCREENS_OTH_TEXT = black blue
SCREENS_CUR_BORDER = black magenta
SCREENS_CUR_TEXT = black magenta
PRESSURE_STALL_THREEHUNDRED = blue default
