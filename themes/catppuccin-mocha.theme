# Catppuccin Mocha-inspired htop theme (8-color terminal palette).
# Best with a Catppuccin Mocha terminal color scheme.
# https://github.com/catppuccin/catppuccin
name=Catppuccin Mocha
force_black_bg=0

DEFAULT_COLOR = white default
RESET_COLOR = white default
FUNCTION_BAR = black blue
FUNCTION_KEY = white default
PANEL_HEADER_FOCUS = black magenta
PANEL_HEADER_UNFOCUS = black magenta
PANEL_SELECTION_FOCUS = black cyan
PANEL_SELECTION_FOLLOW = black yellow
PANEL_SELECTION_UNFOCUS = black white
FAILED_SEARCH = red cyan
FAILED_READ = red default bold
PAUSED = yellow cyan bold
UPTIME = blue default bold
BATTERY = blue default bold
LARGE_NUMBER = red default bold
METER_SHADOW = gray default
METER_TEXT = blue default
METER_VALUE = cyan default bold
METER_VALUE_ERROR = red default bold
METER_VALUE_IOREAD = green default
METER_VALUE_IOWRITE = blue default bold
METER_VALUE_NOTICE = white default bold
METER_VALUE_OK = green default
METER_VALUE_WARN = yellow default bold
LED_COLOR = green default
TASKS_RUNNING = green default bold
PROCESS = white default
PROCESS_SHADOW = gray default
PROCESS_TAG = yellow default bold
PROCESS_MEGABYTES = cyan default
PROCESS_GIGABYTES = green default
PROCESS_BASENAME = blue default bold
PROCESS_TREE = blue default
PROCESS_RUN_STATE = green default
PROCESS_D_STATE = red default bold
PROCESS_HIGH_PRIORITY = red default
PROCESS_LOW_PRIORITY = green default
PROCESS_NEW = black green
PROCESS_TOMB = black red
PROCESS_THREAD = green default
PROCESS_THREAD_BASENAME = green default bold
PROCESS_COMM = magenta default
PROCESS_THREAD_COMM = cyan default bold
PROCESS_PRIV = magenta default
BAR_BORDER = bold
BAR_SHADOW = gray default
SWAP = red default
SWAP_CACHE = yellow default
SWAP_FRONTSWAP = gray default
GRAPH_1 = blue default bold
GRAPH_2 = blue default
MEMORY_1 = green default
MEMORY_2 = magenta default
MEMORY_3 = gray default
MEMORY_4 = blue default bold
MEMORY_5 = yellow default
MEMORY_6 = cyan default
HUGEPAGE_1 = green default
HUGEPAGE_2 = yellow default
HUGEPAGE_3 = red default
HUGEPAGE_4 = blue default bold
LOAD = bold
LOAD_AVERAGE_ONE = white default bold
LOAD_AVERAGE_FIVE = blue default bold
LOAD_AVERAGE_FIFTEEN = blue default
HELP_BOLD = blue default bold
HELP_SHADOW = gray default
CLOCK = bold
DATE = bold
DATETIME = bold
CHECK_BOX = blue default
CHECK_MARK = bold
CHECK_TEXT = white default
HOSTNAME = blue default bold
CPU_NICE = blue default bold
CPU_NICE_TEXT = blue default bold
CPU_NORMAL = green default
CPU_SYSTEM = red default
CPU_IOWAIT = gray default
CPU_IRQ = yellow default
CPU_SOFTIRQ = magenta default
CPU_STEAL = cyan default
CPU_GUEST = cyan default
GPU_ENGINE_1 = green default
GPU_ENGINE_2 = yellow default
GPU_ENGINE_3 = red default
GPU_ENGINE_4 = blue default bold
GPU_RESIDUE = magenta default
PANEL_EDIT = white blue
SCREENS_OTH_BORDER = blue blue
SCREENS_OTH_TEXT = black blue
SCREENS_CUR_BORDER = black magenta
SCREENS_CUR_TEXT = black magenta
PRESSURE_STALL_THREEHUNDRED = blue default
PRESSURE_STALL_SIXTY = blue default bold
PRESSURE_STALL_TEN = white default bold
FILE_DESCRIPTOR_USED = green default
FILE_DESCRIPTOR_MAX = blue default bold
DYNAMIC_GRAY = gray default
DYNAMIC_DARKGRAY = gray default bold
DYNAMIC_RED = red default
DYNAMIC_GREEN = green default
DYNAMIC_BLUE = blue default bold
DYNAMIC_CYAN = cyan default
DYNAMIC_MAGENTA = magenta default
