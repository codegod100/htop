# Catppuccin Mocha-inspired htop theme (8-color terminal palette).
# Best with a Catppuccin Mocha terminal color scheme.
# https://github.com/catppuccin/catppuccin
# Lavender/blue + mauve + peach — not stock cyan/green/red.
name=Catppuccin Mocha
force_black_bg=0

DEFAULT_COLOR = white default
RESET_COLOR = white default
FUNCTION_BAR = black blue
FUNCTION_KEY = white default bold
PANEL_HEADER_FOCUS = black magenta
PANEL_HEADER_UNFOCUS = black magenta
PANEL_SELECTION_FOCUS = black blue
PANEL_SELECTION_FOLLOW = black yellow
PANEL_SELECTION_UNFOCUS = black white
FAILED_SEARCH = black yellow
FAILED_READ = yellow default bold
PAUSED = black yellow bold
UPTIME = blue default bold
BATTERY = blue default bold
LARGE_NUMBER = yellow default bold
METER_SHADOW = gray default
METER_TEXT = blue default
METER_VALUE = white default bold
METER_VALUE_ERROR = yellow default bold
METER_VALUE_IOREAD = blue default bold
METER_VALUE_IOWRITE = magenta default bold
METER_VALUE_NOTICE = white default bold
METER_VALUE_OK = blue default bold
METER_VALUE_WARN = yellow default bold
LED_COLOR = blue default bold
TASKS_RUNNING = blue default bold
PROCESS = white default
PROCESS_SHADOW = gray default
