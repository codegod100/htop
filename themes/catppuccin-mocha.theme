GRAPH_1 = blue default bold
GRAPH_2 = magenta default
MEMORY_1 = blue default bold
MEMORY_2 = magenta default
MEMORY_3 = gray default
MEMORY_4 = yellow default bold
MEMORY_5 = white default
MEMORY_6 = blue default
HUGEPAGE_1 = blue default bold
HUGEPAGE_2 = yellow default
HUGEPAGE_3 = magenta default bold
HUGEPAGE_4 = yellow default bold
LOAD = bold
LOAD_AVERAGE_ONE = white default bold
LOAD_AVERAGE_FIVE = blue default bold
LOAD_AVERAGE_FIFTEEN = blue default
HELP_BOLD = blue default bold
HELP_SHADOW = gray default
CLOCK = blue default bold
DATE = blue default
DATETIME = blue default bold
CHECK_BOX = blue default
CHECK_MARK = blue default bold
