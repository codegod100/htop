# Dracula-inspired htop theme (8-color terminal palette).
# Best with a Dracula terminal color scheme.
# https://draculatheme.com/
# Pink/purple + cyan accents — not stock green/red bars or teal chrome.
name=Dracula
force_black_bg=0

DEFAULT_COLOR = white default
RESET_COLOR = white default
FUNCTION_BAR = black magenta
FUNCTION_KEY = white default bold
PANEL_HEADER_FOCUS = black magenta
PANEL_HEADER_UNFOCUS = black magenta
PANEL_SELECTION_FOCUS = black magenta
PANEL_SELECTION_FOLLOW = black yellow
PANEL_SELECTION_UNFOCUS = black white
FAILED_SEARCH = black yellow
FAILED_READ = yellow default bold
PAUSED = black yellow bold
UPTIME = magenta default bold
BATTERY = magenta default bold
LARGE_NUMBER = yellow default bold
METER_SHADOW = gray default
METER_TEXT = magenta default
METER_VALUE = white default bold
METER_VALUE_ERROR = yellow default bold
METER_VALUE_IOREAD = magenta default bold
METER_VALUE_IOWRITE = blue default bold
METER_VALUE_NOTICE = white default bold
METER_VALUE_OK = magenta default bold
METER_VALUE_WARN = yellow default bold
LED_COLOR = magenta default bold
TASKS_RUNNING = magenta default bold
PROCESS = white default
PROCESS_SHADOW = gray default
PROCESS_TAG = yellow default bold
PROCESS_MEGABYTES = magenta default
PROCESS_GIGABYTES = magenta default bold
PROCESS_BASENAME = magenta default bold
PROCESS_TREE = magenta default
PROCESS_RUN_STATE = magenta default bold
PROCESS_D_STATE = yellow default bold
PROCESS_HIGH_PRIORITY = yellow default bold
PROCESS_LOW_PRIORITY = blue default
PROCESS_NEW = black magenta
PROCESS_TOMB = black yellow
PROCESS_THREAD = blue default
PROCESS_THREAD_BASENAME = blue default bold
PROCESS_COMM = yellow default
PROCESS_THREAD_COMM = blue default bold
PROCESS_PRIV = yellow default bold
BAR_BORDER = magenta default bold
BAR_SHADOW = gray default
SWAP = yellow default bold
SWAP_CACHE = magenta default
SWAP_FRONTSWAP = gray default
GRAPH_1 = magenta default bold
GRAPH_2 = magenta default
MEMORY_1 = magenta default bold
MEMORY_2 = yellow default
MEMORY_3 = gray default
MEMORY_4 = blue default bold
MEMORY_5 = white default
MEMORY_6 = magenta default
HUGEPAGE_1 = magenta default bold
HUGEPAGE_2 = yellow default
HUGEPAGE_3 = yellow default bold
HUGEPAGE_4 = blue default bold
LOAD = bold
LOAD_AVERAGE_ONE = white default bold
LOAD_AVERAGE_FIVE = magenta default bold
LOAD_AVERAGE_FIFTEEN = magenta default
HELP_BOLD = magenta default bold
HELP_SHADOW = gray default
CLOCK = magenta default bold
DATE = magenta default
DATETIME = magenta default bold
CHECK_BOX = magenta default
CHECK_MARK = magenta default bold
CHECK_TEXT = white default
HOSTNAME = magenta default bold
CPU_NICE = blue default bold
CPU_NICE_TEXT = blue default bold
CPU_NORMAL = magenta default bold
CPU_SYSTEM = yellow default bold
CPU_IOWAIT = gray default
CPU_IRQ = yellow default
CPU_SOFTIRQ = magenta default
CPU_STEAL = blue default
CPU_GUEST = blue default bold
GPU_ENGINE_1 = magenta default bold
GPU_ENGINE_2 = yellow default
GPU_ENGINE_3 = yellow default bold
GPU_ENGINE_4 = blue default bold
GPU_RESIDUE = white default
PANEL_EDIT = black magenta
SCREENS_OTH_BORDER = magenta magenta
SCREENS_OTH_TEXT = black magenta
SCREENS_CUR_BORDER = black magenta
SCREENS_CUR_TEXT = black magenta
PRESSURE_STALL_THREEHUNDRED = magenta default
