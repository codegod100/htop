FAILED_READ = yellow default bold
PAUSED = black magenta bold
UPTIME = yellow default bold
BATTERY = yellow default bold
LARGE_NUMBER = yellow default bold
METER_SHADOW = gray default
METER_TEXT = yellow default
METER_VALUE = white default bold
METER_VALUE_ERROR = yellow default bold
METER_VALUE_IOREAD = yellow default bold
METER_VALUE_IOWRITE = blue default bold
METER_VALUE_NOTICE = white default bold
METER_VALUE_OK = yellow default bold
METER_VALUE_WARN = yellow default
LED_COLOR = yellow default bold
